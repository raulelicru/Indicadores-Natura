# Copia este archivo a .streamlit/secrets.toml (gitignored) y completa los valores.
# En Streamlit Community Cloud, configura estas mismas claves en el panel de Secrets.

SUPABASE_URL = "https://<proyecto>.supabase.co"
SUPABASE_ANON_KEY = "<anon-key>"
SUPABASE_SERVICE_ROLE_KEY = "<service-role-key>"   # solo admin server-side

# Dominios de correo permitidos para registro (lista).
ALLOWED_EMAIL_DOMAINS = ["tudominio.com"]

# Habilita el modo demostración (datos sintéticos, sin tocar la BD).
DEMO_MODE_ENABLED = true
